ity and reside under /working\\ntouch temp_workspace/inaccessible.txt\\ntouch temp_workspace/cleanup.log\\ntouch temp_workspace/unique_workspace_files.txt.tmp\\n\\nwhile read p; do\\n    if [[ \\\"$p\\\" == /working/* ]] && [ -r \\\"$p\\\" ]; then\\n        echo \\\"$p\\\" >> temp_workspace/unique_workspace_files.txt.tmp\\n    else\\n        echo \\\"$p\\\" >> temp_workspace/inaccessible.txt\\n        echo \\\"Warning: $p is inaccessible or not under /working. Removing.\\\" >> temp_workspace/cleanup.log\\n    fi\\ndone < temp_workspace/unique_workspace_files.txt\\nmv temp_workspace/unique_workspace_files.txt.tmp temp_workspace/unique_workspace_files.txt\\n\\n# Step 9: Final check\\nif [ -s temp_workspace/unique_workspace_files.txt ]; then\\n    echo \\\"yes\\\"\\nelse\\n    echo \\\"no\\\"\\nfi\\n\"}",
